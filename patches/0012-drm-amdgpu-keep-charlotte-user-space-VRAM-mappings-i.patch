From 36c729f9624e70c0d6e14fabb855dcb374a14baa Mon Sep 17 00:00:00 2001
From: hisi-9000c buildbot <buildbot@localhost>
Date: Thu, 26 Nov 2026 14:10:00 +0800
Subject: [PATCH 2/4] drm/amdgpu: keep charlotte user-space VRAM mappings in
 GTT

CPU mappings of this card's VRAM have been observed to abort with
an SError after the visible-window check, so do not hand them to user
space at all.  Move non-pinned VRAM BOs to GTT on mmap and on fault;
refuse pinned BOs instead (scanout and fbdev buffers stay in VRAM and
use the kernel's 8-byte I/O path).

Keep a check in the TTM I/O reservation path so that any VRAM mapping
that would fall outside the 56 MiB CPU window fails loudly instead of
faulting later.
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c | 69 +++++++++++++++++++++++++
 drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c |  8 +++
 2 files changed, 77 insertions(+)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
index b7ebae2..4a9c8ba 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
@@ -153,10 +153,42 @@ amdgpu_gem_update_bo_mapping(struct drm_file *filp,
 		drm_syncobj_add_point(syncobj, chain, last_update, point);
 }
 
+/*
+ * Board quirk: CPU mappings of this GPU's VRAM are not reliable through
+ * the PCIe1 BAR window.  Keep user-space CPU access in GTT; scanout and
+ * fbdev buffers stay in VRAM and use the kernel's 8-byte I/O path.
+ */
+static bool amdgpu_gem_force_gtt(struct amdgpu_device *adev)
+{
+	return adev->pdev->vendor == 0x1002 && adev->pdev->device == 0x6611;
+}
+
+/* The caller must hold the TTM reservation for @bo. */
+static int amdgpu_gem_bo_move_to_gtt_locked(struct amdgpu_device *adev,
+					     struct amdgpu_bo *bo)
+{
+	struct ttm_operation_ctx ctx = { false, false };
+
+	if (!bo->tbo.resource || bo->tbo.resource->mem_type != TTM_PL_VRAM)
+		return 0;
+
+	if (bo->tbo.pin_count) {
+		dev_warn_ratelimited(adev->dev,
+			"mmap/fault: refusing pinned VRAM BO (%s): start=0x%llx size=0x%llx\n",
+			current->comm, (u64)(bo->tbo.resource->start << PAGE_SHIFT),
+			(u64)bo->tbo.base.size);
+		return -EBUSY;
+	}
+
+	amdgpu_bo_placement_from_domain(bo, AMDGPU_GEM_DOMAIN_GTT);
+	return ttm_bo_validate(&bo->tbo, &bo->placement, &ctx);
+}
+
 static vm_fault_t amdgpu_gem_fault(struct vm_fault *vmf)
 {
 	struct ttm_buffer_object *bo = vmf->vma->vm_private_data;
 	struct drm_device *ddev = bo->base.dev;
+	struct amdgpu_device *adev = drm_to_adev(ddev);
 	vm_fault_t ret;
 	int idx;
 
@@ -165,6 +197,20 @@ static vm_fault_t amdgpu_gem_fault(struct vm_fault *vmf)
 		return ret;
 
 	if (drm_dev_enter(ddev, &idx)) {
+		if (amdgpu_gem_force_gtt(adev) && bo->resource &&
+		    bo->resource->mem_type == TTM_PL_VRAM) {
+			int r = amdgpu_gem_bo_move_to_gtt_locked(adev, bo);
+
+			if (r) {
+				if (r == -EBUSY || r == -ERESTARTSYS)
+					ret = VM_FAULT_NOPAGE;
+				else
+					ret = VM_FAULT_SIGBUS;
+				drm_dev_exit(idx);
+				goto unlock;
+			}
+		}
+
 		ret = amdgpu_bo_fault_reserve_notify(bo);
 		if (ret) {
 			drm_dev_exit(idx);
@@ -396,12 +442,35 @@ out_unlock:
 static int amdgpu_gem_object_mmap(struct drm_gem_object *obj, struct vm_area_struct *vma)
 {
 	struct amdgpu_bo *bo = gem_to_amdgpu_bo(obj);
+	struct amdgpu_device *adev = amdgpu_ttm_adev(bo->tbo.bdev);
 
 	if (amdgpu_ttm_tt_get_usermm(bo->tbo.ttm))
 		return -EPERM;
 	if (bo->flags & AMDGPU_GEM_CREATE_NO_CPU_ACCESS)
 		return -EPERM;
 
+	if (amdgpu_gem_force_gtt(adev) && bo->tbo.resource &&
+	    bo->tbo.resource->mem_type == TTM_PL_VRAM) {
+		int r;
+
+		if (bo->tbo.pin_count) {
+			dev_warn_ratelimited(adev->dev,
+				"mmap: refusing pinned VRAM BO (%s): start=0x%llx size=0x%llx\n",
+				current->comm,
+				(u64)(bo->tbo.resource->start << PAGE_SHIFT),
+				(u64)bo->tbo.base.size);
+			return -EPERM;
+		}
+
+		r = ttm_bo_reserve(&bo->tbo, true, false, NULL);
+		if (r)
+			return r;
+		r = amdgpu_gem_bo_move_to_gtt_locked(adev, bo);
+		amdgpu_bo_unreserve(bo);
+		if (r)
+			return r;
+	}
+
 	/* Workaround for Thunk bug creating PROT_NONE,MAP_PRIVATE mappings
 	 * for debugger access to invisible VRAM. Should have used MAP_SHARED
 	 * instead. Clearing VM_MAYWRITE prevents the mapping from ever
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c
index 2633cf2..0050a6e 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c
@@ -620,6 +620,14 @@ static int amdgpu_ttm_io_mem_reserve(struct ttm_device *bdev,
 	case TTM_PL_VRAM:
 		mem->bus.offset = mem->start << PAGE_SHIFT;
 
+		if (mem->bus.offset + mem->size > adev->gmc.visible_vram_size) {
+			dev_warn_ratelimited(adev->dev,
+				"VRAM CPU map outside visible window (%s): start=0x%llx size=0x%llx visible=0x%llx\n",
+				current->comm, (u64)mem->bus.offset, (u64)mem->size,
+				(u64)adev->gmc.visible_vram_size);
+			return -EINVAL;
+		}
+
 		if (adev->mman.aper_base_kaddr &&
 		    mem->placement & TTM_PL_FLAG_CONTIGUOUS)
 			mem->bus.addr = (u8 *)adev->mman.aper_base_kaddr +
