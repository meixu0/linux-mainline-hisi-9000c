From 57305409a01060d0664e37441920c21a43e107ed Mon Sep 17 00:00:00 2001
From: charlotte bring-up <bringup@localhost>
Date: Tue, 24 Nov 2026 03:52:37 +0800
Subject: [PATCH] pci: dwc: add charlotte PCIe host support

Add a DesignWare glue driver for the Huawei kport PCIe controllers on
the Kirin 9000C (charlotte).  The vendor pcie-kport stack cannot be
ported directly (it depends on the Huawei HCK/pcie_misc framework), so
this driver reproduces only the cold-boot power-on sequence:

  - CRG clock gates for the APB/AXI/TCU/TBU clocks
  - FNPLL setup for the 100 MHz PHY reference clock
  - the kphy v2 PHY init table (DT phy version 1 == PHY v2)
  - PERST via the board GPIO plus the controller's internal PERST
  - NoC power-idle exit and the DBI endpoint split bit

The one non-obvious bit is PCIECTRL0 bit 11 (PCIEIO_OE_EN_HARD_BYPASS):
the vendor driver clears it in pcie_oe_config() and leaving it set keeps
the link from ever training.

PCIe0 (f8000000, onboard ASM1064 SATA) now trains at Gen3 x1 and the
SATA controller enumerates.  PCIe1 (edc00000, external x1 slot) needs
the pcieSwitch LDO (PMIC LDO16) enabled before its DBI is accessible;
it is left disabled until a card is available for testing.
---
 arch/arm64/boot/dts/hisilicon/charlotte.dtsi |  72 +++
 drivers/pci/controller/dwc/Kconfig           | 531 +++++++++++++++
 drivers/pci/controller/dwc/Makefile          |  57 ++
 drivers/pci/controller/dwc/pcie-charlotte.c  | 647 +++++++++++++++++++
 4 files changed, 1307 insertions(+)
 create mode 100644 drivers/pci/controller/dwc/Kconfig
 create mode 100644 drivers/pci/controller/dwc/Makefile
 create mode 100644 drivers/pci/controller/dwc/pcie-charlotte.c

diff --git a/arch/arm64/boot/dts/hisilicon/charlotte.dtsi b/arch/arm64/boot/dts/hisilicon/charlotte.dtsi
index ddc1480..8c7a322 100644
--- a/arch/arm64/boot/dts/hisilicon/charlotte.dtsi
+++ b/arch/arm64/boot/dts/hisilicon/charlotte.dtsi
@@ -272,6 +272,78 @@ dwc3: dwc3@efc00000 {
 		};
 	};
 
+	/*
+	 * PCIe0: onboard ASMedia ASM1064 SATA controller (x1, Gen3).
+	 * PCIe1: external x1 slot (currently empty).
+	 * Both root complexes are Huawei kport blocks around a DW core.
+	 */
+	pcie0: pcie@f8000000 {
+		compatible = "hisilicon,charlotte-pcie";
+		device_type = "pci";
+		reg = <0x0 0xf8000000 0x0 0x400000>,
+		      <0x0 0xee0a3000 0x0 0x1000>,
+		      <0x0 0xee0a0000 0x0 0x3000>,
+		      <0x0 0xf8400000 0x0 0x2000>,
+		      <0x0 0xee262000 0x0 0x1000>,
+		      <0x0 0xee263000 0x0 0x1000>,
+		      <0x0 0xfb21b000 0x0 0x1000>,
+		      <0x0 0xffb81000 0x0 0x1000>,
+		      <0x0 0xff806000 0x0 0x1000>;
+		reg-names = "dbi", "apb", "phy", "config",
+			    "crg", "pll", "sctrl", "pmctrl", "gpio";
+		perst-gpio = <14>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		#interrupt-cells = <1>;
+		interrupt-map-mask = <0 0 0 7>;
+		interrupt-map = <0 0 0 1 &gic GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>,
+				<0 0 0 2 &gic GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
+				<0 0 0 3 &gic GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>,
+				<0 0 0 4 &gic GIC_SPI 96 IRQ_TYPE_LEVEL_HIGH>;
+		bus-range = <0 0xff>;
+		ranges = <0x02000000 0x0 0xf8500000 0x0 0xf8500000 0x0 0x01d00000>;
+		num-lanes = <1>;
+		max-link-speed = <3>;
+		rc-id = <0>;
+		status = "okay";
+	};
+
+
+	/* PCIe1: external x1 slot (ASM1064 sits on PCIe0). */
+	pcie1: pcie@edc00000 {
+		compatible = "hisilicon,charlotte-pcie";
+		device_type = "pci";
+		reg = <0x0 0xedc00000 0x0 0x400000>,
+		      <0x0 0xee1a3000 0x0 0x1000>,
+		      <0x0 0xee1a0000 0x0 0x3000>,
+		      <0x0 0xea000000 0x0 0x2000>,
+		      <0x0 0xee262000 0x0 0x1000>,
+		      <0x0 0xee263000 0x0 0x1000>,
+		      <0x0 0xfb21b000 0x0 0x1000>,
+		      <0x0 0xffb81000 0x0 0x1000>,
+		      <0x0 0xee267000 0x0 0x1000>;
+		reg-names = "dbi", "apb", "phy", "config",
+			    "crg", "pll", "sctrl", "pmctrl", "gpio";
+		perst-gpio = <9>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		#interrupt-cells = <1>;
+		interrupt-map-mask = <0 0 0 7>;
+		interrupt-map = <0 0 0 1 &gic GIC_SPI 104 IRQ_TYPE_LEVEL_HIGH>,
+				<0 0 0 2 &gic GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>,
+				<0 0 0 3 &gic GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>,
+				<0 0 0 4 &gic GIC_SPI 107 IRQ_TYPE_LEVEL_HIGH>;
+		bus-range = <0 0xff>;
+		ranges = <0x02000000 0x0 0xea100000 0x0 0xea100000 0x0 0x03b00000>;
+		num-lanes = <1>;
+		max-link-speed = <3>;
+		rc-id = <1>;
+		/* DBI of this RC is not accessible yet on a cold boot;
+		 * keep it disabled until a card is present and its power
+		 * sequencing can be debugged against the vendor driver.
+		 */
+		status = "disabled";
+	};
 	reserved-memory {
 		#address-cells = <2>;
 		#size-cells = <2>;
diff --git a/drivers/pci/controller/dwc/Kconfig b/drivers/pci/controller/dwc/Kconfig
new file mode 100644
index 0000000..0da374c
--- /dev/null
+++ b/drivers/pci/controller/dwc/Kconfig
@@ -0,0 +1,531 @@
