From e225b3f29154cb42662c697c5c2b2e39e5cdf577 Mon Sep 17 00:00:00 2001
From: charlotte bring-up <bringup@localhost>
Date: Tue, 24 Nov 2026 00:48:12 +0800
Subject: [PATCH 1/6] arm64: dts: hisilicon: add QHW-100 (charlotte) board
 support

Add the device tree for the HUAWEI QHW-100 single board computer, which is
based on the Kirin 9000C SoC.  charlotte.dtsi carries the SoC-level nodes
used by the bring-up kernel (CPUs, V500 UART, UFS controller and the
system-controller blocks), charlotte-9000c.dts is the board file.

Signed-off-by: charlotte bring-up <bringup@localhost>
---
 arch/arm64/boot/dts/hisilicon/Makefile        |   1 +
 .../boot/dts/hisilicon/charlotte-9000c.dts    |  51 ++
 arch/arm64/boot/dts/hisilicon/charlotte.dtsi  | 349 +++++++
 drivers/misc/dss-power-probe.c                | 118 +++
 drivers/tty/serial/uart-v500-earlycon.c       |  61 ++
 drivers/tty/serial/uart-v500.c                | 530 +++++++++++
 drivers/ufs/host/ufs-charlotte.c              | 853 ++++++++++++++++++
 7 files changed, 1963 insertions(+)
 create mode 100644 arch/arm64/boot/dts/hisilicon/charlotte-9000c.dts
 create mode 100644 arch/arm64/boot/dts/hisilicon/charlotte.dtsi
 create mode 100644 drivers/misc/dss-power-probe.c
 create mode 100644 drivers/tty/serial/uart-v500-earlycon.c
 create mode 100644 drivers/tty/serial/uart-v500.c
 create mode 100644 drivers/ufs/host/ufs-charlotte.c

diff --git a/arch/arm64/boot/dts/hisilicon/Makefile b/arch/arm64/boot/dts/hisilicon/Makefile
index f4d68ca..b12f308 100644
--- a/arch/arm64/boot/dts/hisilicon/Makefile
+++ b/arch/arm64/boot/dts/hisilicon/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
+dtb-$(CONFIG_ARCH_HISI) += charlotte-9000c.dtb
 dtb-$(CONFIG_ARCH_HISI) += hi3660-hikey960.dtb
 dtb-$(CONFIG_ARCH_HISI) += hi3670-hikey970.dtb
 dtb-$(CONFIG_ARCH_HISI) += hi3798cv200-poplar.dtb
diff --git a/arch/arm64/boot/dts/hisilicon/charlotte-9000c.dts b/arch/arm64/boot/dts/hisilicon/charlotte-9000c.dts
new file mode 100644
index 0000000..981e099
--- /dev/null
+++ b/arch/arm64/boot/dts/hisilicon/charlotte-9000c.dts
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal HiSilicon Kirin 9000C ("charlotte") board.
+ *
+ * Boot chain on this device:
+ *   fastboot -> UEFI payload in a fake Android boot.img -> GRUB
+ *            -> Linux Image + this DTB
+ *
+ * The live firmware passes the UEFI memory map in /chosen, so the memory
+ * node below is only a fallback for direct non-EFI boot.  The firmware
+ * reserved regions are described in charlotte.dtsi.
+ */
+
+/dts-v1/;
+
+#include "charlotte.dtsi"
+
+/ {
+	model = "HUAWEI Kirin 9000C";
+	compatible = "hisilicon,charlotte";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		/*
+		 * Do not use the V500 earlycon by default: UART0 may not be
+		 * initialized by UEFI and earlycon polling can hang before the
+		 * framebuffer appears.  console=tty0 is the video path.
+		 * The V500 earlycon remains available for a UART-equipped
+		 * debug setup with earlycon=uart_v500,0xff894000.
+		 */
+		bootargs = "console=tty0 keep_bootcon loglevel=7";
+		stdout-path = &uart0;
+	};
+
+	memory@400000 {
+		device_type = "memory";
+		reg = <0x0 0x400000 0x0 0xbffa0000>;
+	};
+};
+
+/*
+ * UFS bring-up probe: enable the controller node so the scaffold driver can
+ * perform read-only register sanity checks.  Remove this override once the
+ * real HUF S port lands.
+ */
+&ufs {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/hisilicon/charlotte.dtsi b/arch/arm64/boot/dts/hisilicon/charlotte.dtsi
new file mode 100644
index 0000000..ddc1480
--- /dev/null
+++ b/arch/arm64/boot/dts/hisilicon/charlotte.dtsi
@@ -0,0 +1,349 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal HiSilicon Kirin 9000C ("charlotte") SoC description.
+ *
+ * Derived from the live vendor device tree:
+ *   dtc -I fs -O dts -o hisi-charlotte-current.dts /proc/device-tree
+ *
+ * This is a bring-up skeleton, not a complete board description.
+ * The vendor UART, UFS, PMIC, DPU, GPU, and secure-world drivers are not
+ * present in mainline.  Only the architectural pieces needed for early
+ * boot are described here.
+ */
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	#address-cells = <2>;
+	#size-cells = <2>;
+	interrupt-parent = <&gic>;
+
+	psci {
+		compatible = "arm,psci";
+		method = "smc";
+		cpu_suspend = <0xc4000001>;
+		cpu_off = <0x84000002>;
+		cpu_on = <0xc4000003>;
+		system_reset = <0x84000009>;
+		system_off = <0x84000008>;
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu-map {
+			cluster0 {
+				core0 { cpu = <&cpu0>; };
+				core1 { cpu = <&cpu1>; };
+				core2 { cpu = <&cpu2>; };
+				core3 { cpu = <&cpu3>; };
+			};
+
+			cluster1 {
+				core0 {
+					thread0 { cpu = <&cpu4>; };
+					thread1 { cpu = <&cpu5>; };
+				};
+				core1 {
+					thread0 { cpu = <&cpu6>; };
+					thread1 { cpu = <&cpu7>; };
+				};
+				core2 {
+					thread0 { cpu = <&cpu8>; };
+					thread1 { cpu = <&cpu9>; };
+				};
+			};
+
+			cluster2 {
+				core0 {
+					thread0 { cpu = <&cpu10>; };
+					thread1 { cpu = <&cpu11>; };
+				};
+			};
+		};
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x0>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <130>;
+		};
+
+		cpu1: cpu@100 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x100>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <130>;
+		};
+
+		cpu2: cpu@200 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x200>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <130>;
+		};
+
+		cpu3: cpu@300 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x300>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <130>;
+		};
+
+		cpu4: cpu@400 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a76";
+			reg = <0x400>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <373>;
+		};
+
+		cpu5: cpu@401 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a76";
+			reg = <0x401>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <373>;
+		};
+
+		cpu6: cpu@500 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a76";
+			reg = <0x500>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <373>;
+		};
+
+		cpu7: cpu@501 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a76";
+			reg = <0x501>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <373>;
+		};
+
+		cpu8: cpu@600 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a76";
+			reg = <0x600>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <373>;
+		};
+
+		cpu9: cpu@601 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a76";
+			reg = <0x601>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <373>;
+		};
+
+		cpu10: cpu@700 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x700>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <484>;
+		};
+
+		cpu11: cpu@701 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x701>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <484>;
+		};
+	};
+
+	gic: interrupt-controller@ff000000 {
+		compatible = "arm,gic-v3";
+		reg = <0x0 0xff000000 0x0 0x10000>,
+		      <0x0 0xff040000 0x0 0x180000>;
+		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-controller;
+		#interrupt-cells = <3>;
+		redistributor-stride = <0x0 0x20000>;
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
+		clock-frequency = <1920000>;
+	};
+
+	/*
+	 * UART V500.  The vendor driver is not in mainline.  The node is kept
+	 * here so a ported earlycon driver can match it and so the board DTS
+	 * can point chosen/stdout-path at the real console UART.
+	 */
+	uart0: serial@ff894000 {
+		compatible = "hisilicon,uart";
+		reg = <0x0 0xff894000 0x0 0x1000>;
+		interrupts = <GIC_SPI 395 IRQ_TYPE_LEVEL_HIGH>;
+		status = "okay";
+	};
+
+	uart4: serial@ff881000 {
+		compatible = "hisilicon,uart";
+		reg = <0x0 0xff881000 0x0 0x1000>;
+		interrupts = <GIC_SPI 396 IRQ_TYPE_LEVEL_HIGH>;
+		status = "disabled";
+	};
+
+	uart5: serial@ff885000 {
+		compatible = "hisilicon,uart";
+		reg = <0x0 0xff885000 0x0 0x1000>;
+		interrupts = <GIC_SPI 397 IRQ_TYPE_LEVEL_HIGH>;
+		status = "disabled";
+	};
+
+	uart6: serial@ffb82000 {
+		compatible = "hisilicon,uart";
+		reg = <0x0 0xffb82000 0x0 0x1000>;
+		interrupts = <GIC_SPI 398 IRQ_TYPE_LEVEL_HIGH>;
+		status = "disabled";
+	};
+
+	/*
+	 * Huawei UFS host controller ("hufs"), not the older
+	 * hisilicon,hi3660-ufs/hi3670-ufs block handled by mainline
+	 * drivers/ufs/host/ufs-hisi.c.
+	 *
+	 * Keep disabled until the vendor hufs_hcd/hufs_plat/hufs_mphy
+	 * stack is ported.  The mainline ufs-hisi driver must not bind
+	 * to this compatible.
+	 */
+	ufs: ufs@fa500000 {
+		compatible = "hisilicon,hufs";
+		reg = <0x0 0xfa500000 0x0 0x80000>,
+		      <0x0 0xfa3fd000 0x0 0x1000>,
+		      <0x0 0xfa400000 0x0 0x100000>,
+		      <0x0 0xfa58a000 0x0 0x1000>,
+		      <0x0 0xfb8c3000 0x0 0x1000>;
+		interrupts = <GIC_SPI 134 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 120 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 121 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 122 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 123 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 124 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 126 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 127 IRQ_TYPE_LEVEL_HIGH>;
+		status = "disabled";
+	};
+
+	/*
+	 * USB2 host path for bring-up/CLI input.  The vendor glue driver
+	 * "hisilicon,dwc3-usb" is handled by the mainline dwc3-of-simple
+	 * glue, which only enables optional clocks/resets and populates the
+	 * snps,dwc3 child.
+	 *
+	 * No PHY node is attached yet.  USB2 PHY/VBUS are expected to be
+	 * left configured by UEFI; if that is not true, the vendor
+	 * usb2-phy-t5/combophy port is the next step.
+	 */
+	usb: usb@efc00000 {
+		compatible = "hisilicon,dwc3-usb";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+		status = "okay";
+
+		dwc3: dwc3@efc00000 {
+			compatible = "snps,dwc3";
+			reg = <0xefc00000 0x100000>;
+			interrupts = <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>;
+			dr_mode = "host";
+			maximum-speed = "high-speed";
+			phy_type = "utmi";
+			snps,hsphy_interface = "utmi";
+			snps,dis_u2_susphy_quirk;
+			snps,dis_u3_susphy_quirk;
+			status = "okay";
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		hifi-base@2da00000 {
+			reg = <0x0 0x2da00000 0x0 0xf80000>;
+			no-map;
+		};
+
+		sensorhub-share-mem@10640000 {
+			reg = <0x0 0x10640000 0x0 0x80000>;
+			no-map;
+		};
+
+		hhee@113c0000 {
+			reg = <0x0 0x113c0000 0x0 0x800000>;
+			no-map;
+		};
+
+		npu-sec@2e980000 {
+			reg = <0x0 0x2e980000 0x0 0x700000>;
+			no-map;
+		};
+
+		bbox-mem@2f600000 {
+			reg = <0x0 0x2f600000 0x0 0x620000>;
+			no-map;
+		};
+
+		bl31@13e00000 {
+			reg = <0x0 0x13e00000 0x0 0x200000>;
+			no-map;
+		};
+
+		s4-bl31-ex@18300000 {
+			reg = <0x0 0x18300000 0x0 0x80000>;
+			no-map;
+		};
+
+		lpmcu@12840000 {
+			reg = <0x0 0x12840000 0x0 0xc0000>;
+			no-map;
+		};
+
+		bl31-ns@2fc20000 {
+			reg = <0x0 0x2fc20000 0x0 0x20000>;
+			no-map;
+		};
+
+		secos-ex@2bd80000 {
+			reg = <0x0 0x2bd80000 0x0 0x480000>;
+			no-map;
+		};
+
+		sensorhub-s@12900000 {
+			reg = <0x0 0x12900000 0x0 0xd00000>;
+			no-map;
+		};
+
+		s4-ns-mem@30740000 {
+			reg = <0x0 0x30740000 0x0 0x180000>;
+			no-map;
+		};
+
+		lpmx-core@127c0000 {
+			reg = <0x0 0x127c0000 0x0 0x80000>;
+			no-map;
+		};
+
+		pstore-mem@2fc40000 {
+			reg = <0x0 0x2fc40000 0x0 0x100000>;
+		};
+	};
+};
diff --git a/drivers/misc/dss-power-probe.c b/drivers/misc/dss-power-probe.c
new file mode 100644
index 0000000..c406dc1
--- /dev/null
+++ b/drivers/misc/dss-power-probe.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Kirin 9000C (charlotte) display-subsystem power bring-up probe.
+ *
+ * The vendor BSP powers the media1/vivobus/dss power domains through the
+ * ATF "ip regulator" service:
+ *
+ *   arm_smccc_smc(make_fid(FID_REGU_GROUP=7, 0) = 0xC3000700,
+ *                 regulator_id, REGULATOR_ENABLE(=1), 0, ...)
+ *
+ * with the AP vote bits set in the sctrl AOD register first:
+ *   0xFB21B000 + 0x438:  bit0 AP media1, bit2 AP vivobus, bit4 AP dss
+ *
+ * Regulator ids (vendor char_autofs.h):
+ *   0 media1_subsys, 1 media2_subsys, 2 vivobus, 3 vcodecsubsys,
+ *   4 dsssubsys, 5 dispch1, 6 ipp, 7 vdec, ...
+ *
+ * This probe only powers things on and then tries to read the DPU register
+ * window.  It does not program anything.
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+
+#define IP_REGULATOR_FID	0xC3000700UL
+#define REGU_ENABLE		1
+
+#define SCTRL_BASE		0xFB21B000UL
+#define SCTRL_AOD_VOTE		0x438
+#define VOTE_AP_MEDIA1		BIT(0)
+#define VOTE_AP_VIVOBUS		BIT(2)
+#define VOTE_AP_DSS		BIT(4)
+
+static const struct {
+	unsigned int id;
+	const char *name;
+} regus[] = {
+	{ 0,  "media1_subsys" },
+	{ 2,  "vivobus" },
+	{ 4,  "dsssubsys" },
+	{ 5,  "disp_ch1subsys" },
+	{ 14, "vivobus_autodiv" },
+};
+
+static void smc_probe(unsigned long fid, unsigned long a1, unsigned long a2,
+		      const char *what)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(fid, a1, a2, 0, 0, 0, 0, 0, &res);
+	pr_info("dss-probe: SMC %-22s fid=%#lx a1=%#lx -> %#lx %#lx %#lx %#lx\n",
+		what, fid, a1, res.a0, res.a1, res.a2, res.a3);
+}
+
+static int __init dss_power_probe(void)
+{
+	void __iomem *sctrl, *crg, *dpu;
+	unsigned int vote;
+	int i;
+
+	pr_info("dss-probe: start\n");
+
+	/* 0. sanity: does the SMC conduit work at all? (PSCI version) */
+	smc_probe(0x84000000UL, 0, 0, "PSCI_VERSION");
+
+	/* 0b. our vendor FID with a bogus id, to see how ATF answers */
+	smc_probe(IP_REGULATOR_FID, 0xff, 0, "regu bogus id");
+
+	/* 1. AP votes for media1 / vivobus / dss */
+	sctrl = ioremap(SCTRL_BASE, 0x1000);
+	if (!sctrl) {
+		pr_err("dss-probe: ioremap sctrl failed\n");
+		return 0;
+	}
+	vote = readl(sctrl + SCTRL_AOD_VOTE);
+	pr_info("dss-probe: aod vote before = %#x\n", vote);
+	vote |= VOTE_AP_MEDIA1 | VOTE_AP_VIVOBUS | VOTE_AP_DSS;
+	writel(vote, sctrl + SCTRL_AOD_VOTE);
+	pr_info("dss-probe: aod vote after  = %#x\n",
+		readl(sctrl + SCTRL_AOD_VOTE));
+
+	/* 2. ask ATF to power the rails on */
+	for (i = 0; i < ARRAY_SIZE(regus); i++)
+		smc_probe(IP_REGULATOR_FID, regus[i].id, REGU_ENABLE,
+			  regus[i].name);
+
+	msleep(50);
+
+	/* 2b. peek at the peripheral CRG block (always-on, vendor does too) */
+	crg = ioremap(0xe8d01000, 0x1000);
+	if (!crg) {
+		pr_err("dss-probe: ioremap crg failed\n");
+	} else {
+		pr_info("dss-probe: CRG e8d01000: %08x %08x %08x %08x %08x %08x\n",
+			readl(crg), readl(crg + 4), readl(crg + 8),
+			readl(crg + 0xc), readl(crg + 0x10), readl(crg + 0x14));
+		iounmap(crg);
+	}
+
+	/* 3. can we touch the DPU now? */
+	dpu = ioremap(0xe8800000, 0x1000);
+	if (!dpu) {
+		pr_err("dss-probe: ioremap dpu failed\n");
+	} else {
+		pr_info("dss-probe: DPU readable: %08x %08x %08x %08x\n",
+			readl(dpu), readl(dpu + 4), readl(dpu + 8),
+			readl(dpu + 0x28));
+		iounmap(dpu);
+	}
+
+	iounmap(sctrl);
+	pr_info("dss-probe: end\n");
+	return 0;
+}
+late_initcall(dss_power_probe);
diff --git a/drivers/tty/serial/uart-v500-earlycon.c b/drivers/tty/serial/uart-v500-earlycon.c
new file mode 100644
index 0000000..30659ae
--- /dev/null
+++ b/drivers/tty/serial/uart-v500-earlycon.c
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Early console for the HiSilicon UART V500.
+ *
+ * Minimal port of the vendor earlycon from:
+ *   platform_source/basicplatform/drivers/tty/serial/uart_v500_console.c
+ *
+ * The bootloader/UEFI is expected to have already configured the UART.
+ * This driver only polls the TX FIFO and writes characters.
+ */
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/serial_core.h>
+
+#define UART_V500_TX_FIFO	0x00c
+#define UART_V500_STAT		0x014
+#define UART_V500_STAT_TX_BUSY	0x001
+#define UART_V500_STAT_TXFF	0x008
+
+static void uart_v500_early_putc(struct uart_port *port, unsigned char c)
+{
+	unsigned int timeout = 100000;
+
+	while ((readl(port->membase + UART_V500_STAT) & UART_V500_STAT_TXFF) &&
+	       --timeout)
+		cpu_relax();
+
+	/* UART may not be enabled by the firmware; never hang earlycon. */
+	if (!timeout)
+		return;
+
+	writel(c, port->membase + UART_V500_TX_FIFO);
+
+	timeout = 100000;
+	while ((readl(port->membase + UART_V500_STAT) & UART_V500_STAT_TX_BUSY) &&
+	       --timeout)
+		cpu_relax();
+}
+
+static void uart_v500_early_write(struct console *con, const char *s,
+				  unsigned int n)
+{
+	struct earlycon_device *dev = con->data;
+
+	uart_console_write(&dev->port, s, n, uart_v500_early_putc);
+}
+
+static int __init uart_v500_early_setup(struct earlycon_device *device,
+					const char *options)
+{
+	if (!device->port.membase)
+		return -ENODEV;
+
+	device->port.iotype = UPIO_MEM32;
+	device->con->write = uart_v500_early_write;
+	return 0;
+}
+
+OF_EARLYCON_DECLARE(uart_v500, "hisilicon,uart", uart_v500_early_setup);
diff --git a/drivers/tty/serial/uart-v500.c b/drivers/tty/serial/uart-v500.c
new file mode 100644
index 0000000..18a91c8
--- /dev/null
+++ b/drivers/tty/serial/uart-v500.c
@@ -0,0 +1,530 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal serial driver for the HiSilicon UART V500.
+ *
+ * Register layout is taken from the vendor driver (GPL-2.0),
+ * platform_source/basicplatform/drivers/tty/serial/uart_v500.c.
+ *
+ * This port is deliberately PIO-only: no dmaengine, pinctrl, reset or
+ * clock-framework dependencies.  The firmware already leaves the console
+ * UART enabled at 115200n8, and mainline 6.18 has no clock provider for
+ * this SoC yet, so:
+ *
+ *   - startup() only unmasks the RX/TX interrupts and clears state;
+ *   - set_termios() reprograms baud/frame only when userspace asks for
+ *     something other than the firmware default (115200 8N1).
+ *
+ * That keeps the known-good firmware configuration intact while giving a
+ * real /dev/ttyHW0 console (input and output).
+ */
+
+#include <linux/console.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/serial_core.h>
+#include <linux/tty.h>
+#include <linux/tty_flip.h>
+
+#define V500_NR_PORTS		8
+#define V500_FIFO_SIZE		64
+#define V500_DEFAULT_UARTCLK	112000000	/* 112 MHz, vendor DT clock-rate */
+
+/* Register offsets */
+#define V500_BAUD_CFG		0x000
+#define V500_FRAME_CFG		0x004
+#define V500_FIFO_CFG		0x008
+#define V500_TX_FIFO		0x00c
+#define V500_RX_FIFO		0x010
+#define V500_STAT		0x014
+#define V500_INT_CLR		0x018
+#define V500_INT_MSK		0x01c
+#define V500_INT_RAW		0x020
+#define V500_INT_STAT		0x024
+#define V500_CONFIG		0x028
+
+/* STAT */
+#define V500_STAT_TXFE		(1 << 2)
+#define V500_STAT_TXFF		(1 << 3)
+#define V500_STAT_RXFE		(1 << 4)
+
+/* Interrupt bits (same bit positions in MSK/CLR/RAW/STATUS) */
+#define V500_INT_RXS		(1 << 0)	/* rx data available */
+#define V500_INT_TXS		(1 << 1)	/* tx fifo level */
+#define V500_INT_RTS		(1 << 2)	/* rx timeout */
+#define V500_INT_ALL		0x7ff
+
+/* FIFO_CFG: TX trigger [2:0], RX trigger [5:3], RTS trigger [8:6] */
+#define V500_FIFO_TX_1_2	(2 << 0)
+#define V500_FIFO_RX_1_8	(0 << 3)
+#define V500_FIFO_RTS_7_8	(4 << 6)
+
+/* Per-character error bits carried in the RX FIFO word */
+#define V500_DR_FE		(1 << 8)
+#define V500_DR_PE		(1 << 9)
+#define V500_DR_BE		(1 << 10)
+#define V500_DR_OE		(1 << 11)
+#define V500_DR_ERR		(V500_DR_FE | V500_DR_PE | V500_DR_BE | V500_DR_OE)
+#define V500_RX_DATA		0xff
+
+/* CONFIG bits (vendor values; low half = set, high half = clear) */
+#define V500_CFG_UART_EN	0x00010001
+#define V500_CFG_TX_EN		0x00020002
+#define V500_CFG_RX_EN		0x00040004
+#define V500_CFG_FIFO_EN	0x04000400
+#define V500_CFG_DIS_ALL	0xffff0000
+
+/* FRAME_CFG */
+#define V500_FRAME_STOP		(1 << 5)
+#define V500_FRAME_PEN		(1 << 4)
+
+#define V500_BAUD_FRAC_MASK	0x3f
+#define V500_BAUD_INT_MASK	0xffff
+#define V500_CONFIG_BIT_MASK	16
+#define V500_ISR_PASS_LIMIT	256
+
+struct v500_port {
+	struct uart_port	port;
+};
+
+#define to_v500_port(p)	container_of(p, struct v500_port, port)
+
+static struct uart_driver v500_uart_driver;
+
+#ifdef CONFIG_SERIAL_UART_V500_CONSOLE
+static struct console v500_console;
+#endif
+
+static DEFINE_XARRAY_FLAGS(v500_ports, XA_FLAGS_ALLOC);
+
+static u32 v500_read(struct uart_port *port, u32 off)
+{
+	return readl(port->membase + off);
+}
+
+static void v500_write(struct uart_port *port, u32 val, u32 off)
+{
+	writel(val, port->membase + off);
+}
+
+static unsigned int v500_tx_empty(struct uart_port *port)
+{
+	return (v500_read(port, V500_STAT) & V500_STAT_TXFE) ? TIOCSER_TEMT : 0;
+}
+
+static void v500_set_mctrl(struct uart_port *port, unsigned int mctrl)
+{
+}
+
+static unsigned int v500_get_mctrl(struct uart_port *port)
+{
+	return TIOCM_DSR | TIOCM_CTS | TIOCM_CAR;
+}
+
+static void v500_stop_tx(struct uart_port *port)
+{
+	v500_write(port, v500_read(port, V500_INT_MSK) | V500_INT_TXS,
+		   V500_INT_MSK);
+}
+
+static void v500_tx_chars(struct uart_port *port)
+{
+	u8 ch;
+
+	uart_port_tx_limited(port, ch, port->fifosize >> 1,
+			     !(v500_read(port, V500_STAT) & V500_STAT_TXFF),
+			     v500_write(port, ch, V500_TX_FIFO),
+			     ({}));
+}
+
+static void v500_start_tx(struct uart_port *port)
+{
+	v500_write(port, v500_read(port, V500_INT_MSK) & ~V500_INT_TXS,
+		   V500_INT_MSK);
+	v500_tx_chars(port);
+}
+
+static void v500_stop_rx(struct uart_port *port)
+{
+	v500_write(port, v500_read(port, V500_INT_MSK) | V500_INT_RXS,
+		   V500_INT_MSK);
+}
+
+/* must be called with the port lock held; caller does the flip push */
+static void v500_rx_chars(struct uart_port *port)
+{
+	unsigned int max_count = V500_FIFO_SIZE * 4;
+
+	while (max_count--) {
+		u32 ch, flag = TTY_NORMAL;
+
+		if (v500_read(port, V500_STAT) & V500_STAT_RXFE)
+			break;
+
+		ch = v500_read(port, V500_RX_FIFO);
+		port->icount.rx++;
+
+		if (unlikely(ch & V500_DR_ERR)) {
+			if (ch & V500_DR_BE) {
+				port->icount.brk++;
+				flag = TTY_BREAK;
+			} else if (ch & V500_DR_PE) {
+				port->icount.parity++;
+				flag = TTY_PARITY;
+			} else if (ch & V500_DR_FE) {
+				port->icount.frame++;
+				flag = TTY_FRAME;
+			}
+			if (ch & V500_DR_OE)
+				port->icount.overrun++;
+			ch &= V500_RX_DATA;
+			uart_insert_char(port, ch, 0, ch, flag);
+			continue;
+		}
+
+		ch &= V500_RX_DATA;
+		if (uart_handle_sysrq_char(port, ch))
+			continue;
+		uart_insert_char(port, ch, 0, ch, TTY_NORMAL);
+	}
+}
+
+static irqreturn_t v500_int_handler(int irq, void *dev_id)
+{
+	struct uart_port *port = dev_id;
+	unsigned long flags;
+	unsigned int status, pass = V500_ISR_PASS_LIMIT;
+	bool handled = false, push = false;
+
+	uart_port_lock_irqsave(port, &flags);
+
+	status = v500_read(port, V500_INT_STAT);
+	while (status && pass--) {
+		u32 clr = status & ~(V500_INT_RXS | V500_INT_TXS);
+
+		if (clr)
+			v500_write(port, clr, V500_INT_CLR);
+		if (status & (V500_INT_RXS | V500_INT_RTS)) {
+			v500_rx_chars(port);
+			push = true;
+		}
+		if (status & V500_INT_TXS)
+			v500_tx_chars(port);
+
+		handled = true;
+		status = v500_read(port, V500_INT_STAT);
+	}
+
+	uart_port_unlock_irqrestore(port, flags);
+
+	if (push)
+		tty_flip_buffer_push(&port->state->port);
+
+	return IRQ_RETVAL(handled);
+}
+
+static void v500_enable_ms(struct uart_port *port)
+{
+}
+
+static int v500_startup(struct uart_port *port)
+{
+	u32 mask;
+	int ret;
+
+	/*
+	 * The firmware leaves the RX trigger at 1/2 (32 bytes), which makes
+	 * the console unusable interactively: nothing is delivered until 32
+	 * characters have accumulated.  Use 1/8 and rely on the rx-timeout
+	 * interrupt to flush partial bursts (single keystrokes).
+	 */
+	v500_write(port, V500_FIFO_TX_1_2 | V500_FIFO_RX_1_8 |
+		   V500_FIFO_RTS_7_8, V500_FIFO_CFG);
+
+	/* Clear stale error / rx / tx state left by the firmware. */
+	v500_write(port, V500_INT_ALL, V500_INT_CLR);
+
+	ret = request_irq(port->irq, v500_int_handler, 0, "uart-v500", port);
+	if (ret)
+		return ret;
+
+	/* Mask everything but RX data, rx-timeout and TX-empty. */
+	mask = V500_INT_ALL & ~(V500_INT_RXS | V500_INT_TXS | V500_INT_RTS);
+	v500_write(port, mask, V500_INT_MSK);
+
+	return 0;
+}
+
+static void v500_shutdown(struct uart_port *port)
+{
+	v500_write(port, V500_INT_ALL, V500_INT_MSK);
+	v500_write(port, V500_INT_ALL, V500_INT_CLR);
+	free_irq(port->irq, port);
+}
+
+static void v500_set_termios(struct uart_port *port, struct ktermios *termios,
+			     const struct ktermios *old)
+{
+	unsigned int baud, quot, frame = 0;
+
+	baud = uart_get_baud_rate(port, termios, old, 0, port->uartclk / 16);
+	if (!baud)
+		return;
+
+	uart_update_timeout(port, termios->c_cflag, baud);
+
+	/*
+	 * The firmware already configured the console UART for 115200 8N1;
+	 * do not touch a known-good configuration for the common case.
+	 */
+	if (baud == 115200 && (termios->c_cflag & CSIZE) == CS8 &&
+	    !(termios->c_cflag & (PARENB | CSTOPB)))
+		return;
+
+	if (baud > port->uartclk / 16)
+		quot = DIV_ROUND_CLOSEST(port->uartclk * 8, baud);
+	else
+		quot = DIV_ROUND_CLOSEST(port->uartclk * 4, baud);
+
+	switch (termios->c_cflag & CSIZE) {
+	case CS5: frame = 0; break;
+	case CS6: frame = 1; break;
+	case CS7: frame = 2; break;
+	default:  frame = 3; break;
+	}
+	if (termios->c_cflag & CSTOPB)
+		frame |= V500_FRAME_STOP;
+	if (termios->c_cflag & PARENB)
+		frame |= V500_FRAME_PEN;
+	v500_write(port, frame, V500_FRAME_CFG);
+
+	/* Re-enable the block, then program the divisor. */
+	v500_write(port, V500_CFG_DIS_ALL, V500_CONFIG);
+	v500_write(port, V500_CFG_UART_EN | V500_CFG_TX_EN |
+		   V500_CFG_RX_EN | V500_CFG_FIFO_EN, V500_CONFIG);
+
+	v500_write(port, ((quot & V500_BAUD_FRAC_MASK) << V500_CONFIG_BIT_MASK) |
+		   ((quot >> 6) & V500_BAUD_INT_MASK), V500_BAUD_CFG);
+}
+
+static const char *v500_type(struct uart_port *port)
+{
+	return "UART-V500";
+}
+
+static void v500_config_port(struct uart_port *port, int flags)
+{
+	if (flags & UART_CONFIG_TYPE)
+		port->type = PORT_16550A;
+}
+
+static int v500_verify_port(struct uart_port *port, struct serial_struct *ser)
+{
+	if (ser->type != PORT_UNKNOWN && ser->type != port->type)
+		return -EINVAL;
+	return 0;
+}
+
+static const struct uart_ops v500_ops = {
+	.tx_empty	= v500_tx_empty,
+	.set_mctrl	= v500_set_mctrl,
+	.get_mctrl	= v500_get_mctrl,
+	.stop_tx	= v500_stop_tx,
+	.start_tx	= v500_start_tx,
+	.stop_rx	= v500_stop_rx,
+	.enable_ms	= v500_enable_ms,
+	.startup	= v500_startup,
+	.shutdown	= v500_shutdown,
+	.set_termios	= v500_set_termios,
+	.type		= v500_type,
+	.config_port	= v500_config_port,
+	.verify_port	= v500_verify_port,
+};
+
+static int v500_probe(struct platform_device *pdev)
+{
+	struct v500_port *up;
+	struct uart_port *port;
+	struct resource *res;
+	struct xa_limit limit;
+	u32 clk = V500_DEFAULT_UARTCLK;
+	int irq, line, ret;
+
+	up = devm_kzalloc(&pdev->dev, sizeof(*up), GFP_KERNEL);
+	if (!up)
+		return -ENOMEM;
+
+	port = &up->port;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -ENODEV;
+	port->membase = devm_ioremap_resource(&pdev->dev, res);
+	if (IS_ERR(port->membase))
+		return PTR_ERR(port->membase);
+	port->mapbase = res->start;
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	of_property_read_u32(pdev->dev.of_node, "clock-frequency", &clk);
+
+	line = of_alias_get_id(pdev->dev.of_node, "serial");
+	limit = (line < 0) ? XA_LIMIT(0, V500_NR_PORTS - 1) : XA_LIMIT(line, line);
+
+	ret = xa_alloc(&v500_ports, &line, up, limit, GFP_KERNEL);
+	if (ret)
+		return ret;
+
+	port->dev	= &pdev->dev;
+	port->iotype	= UPIO_MEM32;
+	port->irq	= irq;
+	port->uartclk	= clk;
+	port->fifosize	= V500_FIFO_SIZE;
+	port->flags	= UPF_BOOT_AUTOCONF;
+	port->ops	= &v500_ops;
+	port->type	= PORT_UNKNOWN;
+	port->line	= line;
+	spin_lock_init(&port->lock);
+
+	platform_set_drvdata(pdev, up);
+
+	ret = uart_add_one_port(&v500_uart_driver, port);
+	if (ret) {
+		xa_erase(&v500_ports, line);
+		return ret;
+	}
+
+	dev_info(&pdev->dev, "ttyHW%d irq %d uartclk %u\n", line, irq, clk);
+	return 0;
+}
+
+static void v500_remove(struct platform_device *pdev)
+{
+	struct v500_port *up = platform_get_drvdata(pdev);
+	int line = up->port.line;
+
+	uart_remove_one_port(&v500_uart_driver, &up->port);
+	xa_erase(&v500_ports, line);
+}
+
+static const struct of_device_id v500_of_match[] = {
+	{ .compatible = "hisilicon,uart" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, v500_of_match);
+
+static struct platform_driver v500_platform_driver = {
+	.probe	= v500_probe,
+	.remove	= v500_remove,
+	.driver	= {
+		.name		= "uart-v500",
+		.of_match_table	= v500_of_match,
+	},
+};
+
+static struct uart_driver v500_uart_driver = {
+	.owner		= THIS_MODULE,
+	.driver_name	= "uart-v500",
+	.dev_name	= "ttyHW",
+	.nr		= V500_NR_PORTS,
+#ifdef CONFIG_SERIAL_UART_V500_CONSOLE
+	.cons		= &v500_console,
+#endif
+};
+
+#ifdef CONFIG_SERIAL_UART_V500_CONSOLE
+
+static void v500_putchar(struct uart_port *port, unsigned char ch)
+{
+	/*
+	 * Block until the FIFO has room.  Dropping characters here makes
+	 * console logs unusable under burst load (the FIFO can stay full for
+	 * several milliseconds at 115200).
+	 */
+	while (v500_read(port, V500_STAT) & V500_STAT_TXFF)
+		cpu_relax();
+	v500_write(port, ch, V500_TX_FIFO);
+}
+
+static void v500_console_write(struct console *co, const char *s,
+			       unsigned int count)
+{
+	struct v500_port *up;
+	struct uart_port *port;
+	unsigned long flags;
+
+	up = xa_load(&v500_ports, co->index);
+	if (!up)
+		return;
+	port = &up->port;
+
+	uart_port_lock_irqsave(port, &flags);
+	uart_console_write(port, s, count, v500_putchar);
+	uart_port_unlock_irqrestore(port, flags);
+}
+
+static int v500_console_setup(struct console *co, char *options)
+{
+	struct v500_port *up;
+	struct uart_port *port;
+	int baud = 115200, bits = 8, parity = 'n', flow = 'n';
+
+	up = xa_load(&v500_ports, co->index);
+	if (!up)
+		return -ENODEV;
+	port = &up->port;
+
+	if (options)
+		uart_parse_options(options, &baud, &parity, &bits, &flow);
+
+	return uart_set_options(port, co, baud, parity, bits, flow);
+}
+
+static struct console v500_console = {
+	.name	= "ttyHW",
+	.write	= v500_console_write,
+	.device	= uart_console_device,
+	.setup	= v500_console_setup,
+	.flags	= CON_PRINTBUFFER,
+	.index	= -1,
+	.data	= &v500_uart_driver,
+};
+
+static int __init v500_console_init(void)
+{
+	register_console(&v500_console);
+	return 0;
+}
+console_initcall(v500_console_init);
+
+#endif /* CONFIG_SERIAL_UART_V500_CONSOLE */
+
+static int __init v500_init(void)
+{
+	int ret;
+
+	ret = uart_register_driver(&v500_uart_driver);
+	if (ret)
+		return ret;
+
+	ret = platform_driver_register(&v500_platform_driver);
+	if (ret)
+		uart_unregister_driver(&v500_uart_driver);
+
+	return ret;
+}
+device_initcall(v500_init);
+
+static void __exit v500_exit(void)
+{
+	platform_driver_unregister(&v500_platform_driver);
+	uart_unregister_driver(&v500_uart_driver);
+}
+module_exit(v500_exit);
+
+MODULE_AUTHOR("charlotte bring-up");
+MODULE_DESCRIPTION("HiSilicon UART V500 serial driver (PIO)");
+MODULE_LICENSE("GPL v2");
diff --git a/drivers/ufs/host/ufs-charlotte.c b/drivers/ufs/host/ufs-charlotte.c
new file mode 100644
index 0000000..f07dfc8
--- /dev/null
+++ b/drivers/ufs/host/ufs-charlotte.c
@@ -0,0 +1,853 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * HiSilicon Kirin 9000C ("charlotte") HUF S UFS bring-up.
+ *
+ * The HUF S controller exposes the UniPro/MPHY attribute space as a plain
+ * MMIO window (resource #2, dword indexed): each UIC attribute N lives at
+ * base + (N << 2), and DME_LOCAL_OPC_STATE reports whether the access is
+ * still busy.  There is no interrupt involvement, so a simple poll works.
+ *
+ * The ASIC MPHY must be configured before DME_LINKSTARTUP, otherwise the
+ * standard UIC link startup times out.  The sequence below is the vendor
+ * "v300" (ASIC) pre-link sequence from
+ * platform_source/basicplatform/drivers/scsi/ufs/ufs_scorpio.c.
+ *
+ * Everything here only touches host/PHY registers, never the flash data.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+
+#include <ufs/ufshcd.h>
+#include "ufshcd-pltfrm.h"
+
+/* Standard UFSHCI registers */
+#define UFSHCI_CAP		0x00
+#define UFSHCI_VER		0x08
+#define UFSHCI_HCS		0x30
+#define UFSHCI_HCE		0x34
+#define UFSHCI_IS		0x20
+
+/* SoC blocks used by ufs_soc_init() (vendor ufs_scorpio.c) */
+#define CHARLOTTE_SCTRL_BASE	0xFB21B000UL
+#define CHARLOTTE_ACTRL_BASE	0xFB214000UL
+#define SCTRL_SCPERRSTEN1	0x20C
+#define SCTRL_SCPERRSTDIS1	0x210
+#define SCTRL_SCPERRSTSTAT1	0x214
+#define SCTRL_SCCLKDIV9		0x274
+#define SCTRL_SCPEREN4		0x1B0
+#define SCTRL_SCEFUSEDATA2	0x00C
+#define BIT_IP_RST_UFS_SUBSYS	14
+#define BIT_IP_RST_UFS_SUBSYS_CRG	19
+#define BIT_GT_CLK_UFS_SUBSYS	14
+#define ACTRL_ISO_EN_GROUP0_PERI	0x000
+#define ACTRL_AO_MEM_CTRL2	0x814
+#define ACTRL_BITMSK_NONSEC_CTRL1 0x400
+#define UFS_SYSCTRL_RESET_CTRL	0x008
+#define UFS_SYSCTRL_MEMCTRL_TP	0x280
+#define UFS_SYSCTRL_AO_MEMCTRL	0x284
+#define UFS_SYSCTRL_MEMCTRL	0x288
+#define UFS_IB_MST_RAM_TMOD	0x104
+#define UFS_MPHY_MCU_MEMCTRL	0x00C
+
+/* HUF S UniPro attribute window */
+#define HUFS_UNIPRO_SHIFT	2
+#define DME_LOCAL_OPC_STATE	0xD066
+#define LOCAL_ATTR_BUSY		0x9
+
+/* Attributes used by the pre-link sequence */
+#define PA_GRANULARITY		0x15aa	/* PA_TActivate sibling */
+#define DME_MPHYCFGUPDT		0xD014
+#define DME_MPHYCFGUPDT_EN	BIT(0)
+#define MPHY_INIT		0xD6
+#define MPHY_INIT_MASK		(BIT(0) | BIT(1))
+#define MPHY_INIT_DONE		(BIT(0) | BIT(1))
+#define DME_UNIPRO_STATE	0xD053
+#define DME_LINKSTARTUPREQ	0xD008
+#define MASK_DEBUG_UNIPRO_STATE	0x3F80
+#define LINK_DOWN		(0x1 << 7)
+#define LINK_UP			(0x2 << 7)
+#define PA_PWRMODE		0x1571
+#define DME_POWERMODEIND	0xD011
+
+#define ATTR_MTX0(x)		((0x0 << 16) | (x))
+#define ATTR_MTX1(x)		((0x1 << 16) | (x))
+#define ATTR_MRX0(x)		((0x2 << 16) | (x))
+#define ATTR_MRX1(x)		((0x3 << 16) | (x))
+
+#define TX_AFE_CONFIG_III	0x7C
+#define TX_VCM_VREF_237		0xF
+#define RX_AFE_CTRL_IV		0x14
+#define CDR_RESET_EN		BIT(2)
+#define AFE_CONFIG_VIII		0x56
+#define TX_TRAILING_CLOCKS_REG	0x1564
+#define TX_TRAILING_CLK_NUMS	0xFA
+#define VS_DDBUG_SAVE_CONFIG_TIME 0x9529
+#define SAVECFG_250NS		0x4
+
+#define TX_DMY1			0x0052
+#define RX_R_CAL		0x00E7
+#define TX_LEVEL		12
+#define RX_LEVEL		9
+#define R_MULTIPLIER		10
+#define R_DIVISOR		9
+#define HALF_R_DIVISOR		(R_DIVISOR / 2)
+#define MIN_TX_R		0x1
+#define MAX_TX_R		0xF
+#define MIN_RX_R		0x1
+#define MAX_RX_R		0x1F
+
+struct ufs_attr_cfg {
+	u32 addr;
+	u32 val;
+};
+
+/* Vendor "v300" (ASIC) MPHY pre-link configuration */
+static const struct ufs_attr_cfg hufs_mphy_v300_pre_link_attr[] = {
+	{ 0x000015A8, 0x00000013 }, /* PA_TActivate */
+	{ 0x0000156A, 0x00000002 }, /* PA_HSSeries */
+	{ 0x00020009, 0x00000001 }, /* Rx SKP_DET_SEL, lane0 */
+	{ 0x00030009, 0x00000001 }, /* Rx SKP_DET_SEL, lane1 */
+	{ 0x000000DF, 0x00000002 }, /* VCO_AUTO_CHG */
+	{ 0x00020003, 0x0000000A }, /* AD_DIF_P_LS_TIMEOUT_VAL, lane0 */
+	{ 0x00030003, 0x0000000A }, /* AD_DIF_P_LS_TIMEOUT_VAL, lane1 */
+	{ 0x00020004, 0x00000064 }, /* AD_DIF_N_LS_TIMEOUT_VAL, lane0 */
+	{ 0x00030004, 0x00000064 }, /* AD_DIF_N_LS_TIMEOUT_VAL, lane1 */
+	{ 0x00020017, 0x00000084 }, /* RX_AFE_CTRL lane0, HW calib */
+	{ 0x00030017, 0x00000084 }, /* RX_AFE_CTRL lane1, HW calib */
+	{ 0x00000057, 0x00000000 }, /* AFE_CONFIG_IX lane0 */
+	{ 0x00010057, 0x00000000 }, /* AFE_CONFIG_IX lane1 */
+	{ 0x00000059, 0x00000022 }, /* AFE_CONFIG_XII lane0 */
+	{ 0x00010059, 0x00000022 }, /* AFE_CONFIG_XII lane1 */
+	{ 0x0000007B, 0x00000023 }, /* TX_AFE_CONFIG_II lane0 */
+	{ 0x0001007B, 0x00000023 }, /* TX_AFE_CONFIG_II lane1 */
+	{ 0x000200F0, 0x00000001 }, /* RX enable lane0 */
+	{ 0x000300F0, 0x00000001 }, /* RX enable lane1 */
+	{ 0x000200C7, 0x00000001 }, /* enable override */
+	{ 0x000300C7, 0x00000001 }, /* enable override */
+	{ 0x00020092, 0x00000001 }, /* RX_HIBERN8TIME_CAPABILITY lane0 */
+	{ 0x00030092, 0x00000001 }, /* RX_HIBERN8TIME_CAPABILITY lane1 */
+	{ 0x0002009D, 0x00000001 }, /* RX_HS_Equalizer_Setting_Capability l0 */
+	{ 0x0003009D, 0x00000001 }, /* RX_HS_Equalizer_Setting_Capability l1 */
+	{ 0x000200C7, 0x00000000 }, /* disable override */
+	{ 0x000300C7, 0x00000000 }, /* disable override */
+	{ 0x000200E9, 0x00000040 }, /* RX_HS_DATA_VALID_TIMER_VAL0 */
+	{ 0x000300E9, 0x00000040 }, /* RX_HS_DATA_VALID_TIMER_VAL0 */
+	{ 0x000200EA, 0x0000001F }, /* RX_HS_DATA_VALID_TIMER_VAL1 */
+	{ 0x000300EA, 0x0000001F }, /* RX_HS_DATA_VALID_TIMER_VAL1 */
+	{ 0x000000C1, 0x00000003 }, /* TX_RG_PLL_CP */
+	{ 0x000100C1, 0x00000003 }, /* TX_RG_PLL_CP */
+	{ 0x000000D2, 0x0000000F }, /* TX_RG_PLL_LPF_R */
+	{ 0x000100D2, 0x0000000F }, /* TX_RG_PLL_LPF_R */
+};
+
+struct charlotte_hufs_host {
+	int core_irq[8];
+	unsigned int nr_core_irq;
+	unsigned int intr_seen;
+	void __iomem *sctrl;
+	void __iomem *actrl;
+	void __iomem *sys_ctrl;
+	void __iomem *mphy_mcu;
+	void __iomem *ib_mst;
+	void __iomem *unipro;
+	struct clk *ref_clk;
+	struct reset_control *rst;
+};
+
+static void charlotte_hufs_qos_init(struct ufs_hba *hba);
+
+static int hufs_uic_wait_idle(struct charlotte_hufs_host *host)
+{
+	unsigned int retries = 1000;
+	u32 state;
+
+	do {
+		state = readl(host->unipro +
+			      (DME_LOCAL_OPC_STATE << HUFS_UNIPRO_SHIFT));
+		if (state != LOCAL_ATTR_BUSY)
+			return 0;
+		udelay(10);
+	} while (--retries);
+
+	return -ETIMEDOUT;
+}
+
+static int hufs_uic_write(struct charlotte_hufs_host *host, u32 attr, u32 val)
+{
+	writel(val, host->unipro + (attr << HUFS_UNIPRO_SHIFT));
+	return hufs_uic_wait_idle(host);
+}
+
+static int hufs_uic_read(struct charlotte_hufs_host *host, u32 attr, u32 *val)
+{
+	*val = readl(host->unipro + (attr << HUFS_UNIPRO_SHIFT));
+	return hufs_uic_wait_idle(host);
+}
+
+static int hufs_wait_mphy_init(struct charlotte_hufs_host *host)
+{
+	unsigned int retries = 4000;	/* 40 ms */
+	u32 val;
+
+	do {
+		if (hufs_uic_read(host, MPHY_INIT, &val))
+			return -ETIMEDOUT;
+		if ((val & MPHY_INIT_MASK) == MPHY_INIT_DONE)
+			return 0;
+		udelay(10);
+	} while (--retries);
+
+	return -ETIMEDOUT;
+}
+
+static void hufs_tx_rx_r_calc(struct charlotte_hufs_host *host)
+{
+	u32 val = 0;
+
+	if (hufs_uic_read(host, ATTR_MTX0(TX_DMY1), &val))
+		return;
+	val &= MAX_TX_R;
+	val = (val + TX_LEVEL) * R_MULTIPLIER;
+	val = (val % R_DIVISOR) ? (val / R_DIVISOR + MIN_TX_R) :
+				  (val / R_DIVISOR);
+	val -= TX_LEVEL;
+	if (val > MAX_TX_R)
+		val = MAX_TX_R;
+	hufs_uic_write(host, ATTR_MTX0(TX_DMY1), val);
+	hufs_uic_write(host, ATTR_MTX1(TX_DMY1), val);
+	hufs_uic_write(host, DME_MPHYCFGUPDT, DME_MPHYCFGUPDT_EN);
+
+	if (hufs_uic_read(host, ATTR_MRX0(RX_R_CAL), &val))
+		return;
+	val &= MAX_RX_R;
+	val = (val + RX_LEVEL) * R_MULTIPLIER;
+	val = (val % R_DIVISOR > HALF_R_DIVISOR) ?
+	      (val / R_DIVISOR + MIN_RX_R) : (val / R_DIVISOR);
+	val -= RX_LEVEL;
+	if (val > MAX_RX_R)
+		val = MAX_RX_R;
+	hufs_uic_write(host, ATTR_MRX0(RX_R_CAL), val);
+	hufs_uic_write(host, ATTR_MRX1(RX_R_CAL), val);
+}
+
+
+/*
+ * hufs_mphy_v300_post_link_attr - verbatim from the vendor driver
+ * (ufs_scorpio.c).  These are UniPro N_/T_ (network/transport) connection
+ * attributes plus a few MPHY knobs.  They must be programmed after the DME
+ * link is up and before the first UPIU, otherwise the UTP transfer fails
+ * with a controller fatal error even though DME_UNIPRO_STATE says LINK_UP.
+ */
+static const struct ufs_attr_cfg hufs_mphy_v300_post_link_attr[] = {
+	{ 0x00003000, 0x00000000 },	/* N_DeviceID */
+	{ 0x00003001, 0x00000001 },	/* N_DeviceID_valid */
+	{ 0x00004020, 0x00000000 },	/* T_ConnectionState */
+	{ 0x00004022, 0x00000000 },	/* T_PeerCPortID */
+	{ 0x00004021, 0x00000001 },	/* T_PeerDeviceID */
+	{ 0x00004023, 0x00000000 },	/* T_TrafficClass */
+	{ 0x00004020, 0x00000001 },	/* T_ConnectionState */
+	{ 0x0002000A, 0x00000002 },	/* RX H8_TIMEOUT_VAL, lane 0 */
+	{ 0x0003000A, 0x00000002 },	/* RX H8_TIMEOUT_VAL, lane 1 */
+	{ 0x000200EB, 0x00000064 },	/* AD_DIF_N_TIMEOUT_VAL */
+	{ 0x000300EB, 0x00000064 },	/* AD_DIF_N_TIMEOUT_VAL */
+	{ 0x0002000E, 0x000000F0 },	/* RX_H8_EXIT_TIME */
+	{ 0x0003000E, 0x000000F0 },	/* RX_H8_EXIT_TIME */
+	{ 0x000000DF, 0x00000003 },	/* VCO_AUTO_CHG */
+	{ 0x000015A8, 0x00000005 },	/* PA_TActivate */
+};
+
+static void charlotte_hufs_phy_post_link(struct ufs_hba *hba,
+					 struct charlotte_hufs_host *host)
+{
+	u32 val = 0;
+	int i;
+
+	dev_dbg(hba->dev, "charlotte hufs: MPHY post-link config\n");
+
+	for (i = 0; i < ARRAY_SIZE(hufs_mphy_v300_post_link_attr); i++) {
+		if (hufs_uic_write(host, hufs_mphy_v300_post_link_attr[i].addr,
+				   hufs_mphy_v300_post_link_attr[i].val))
+			dev_warn(hba->dev, "post uic write 0x%x failed\n",
+				 hufs_mphy_v300_post_link_attr[i].addr);
+	}
+
+	/* vendor check_pa_granularity(): PA_GRANULARITY must be >= 6 */
+	if (!hufs_uic_read(host, PA_GRANULARITY, &val) && val < 6)
+		hufs_uic_write(host, PA_GRANULARITY, 6);
+
+	dev_dbg(hba->dev, "charlotte hufs: MPHY post-link config done\n");
+}
+
+static void charlotte_hufs_phy_pre_link(struct ufs_hba *hba,
+					struct charlotte_hufs_host *host)
+{
+	u32 val = 0;
+	int i;
+
+	dev_dbg(hba->dev, "charlotte hufs: MPHY pre-link config\n");
+
+	for (i = 0; i < ARRAY_SIZE(hufs_mphy_v300_pre_link_attr); i++) {
+		if (hufs_uic_write(host, hufs_mphy_v300_pre_link_attr[i].addr,
+				   hufs_mphy_v300_pre_link_attr[i].val))
+			dev_warn(hba->dev, "uic write 0x%x failed\n",
+				 hufs_mphy_v300_pre_link_attr[i].addr);
+	}
+
+	/* TX VCM VREF = 237.5mV */
+	hufs_uic_write(host, ATTR_MTX0(TX_AFE_CONFIG_III), TX_VCM_VREF_237);
+	hufs_uic_write(host, ATTR_MTX1(TX_AFE_CONFIG_III), TX_VCM_VREF_237);
+
+	/* CDR reset */
+	if (!hufs_uic_read(host, ATTR_MRX0(RX_AFE_CTRL_IV), &val)) {
+		val |= CDR_RESET_EN;
+		hufs_uic_write(host, ATTR_MRX0(RX_AFE_CTRL_IV), val);
+		hufs_uic_write(host, ATTR_MRX1(RX_AFE_CTRL_IV), val);
+	}
+
+	/* analog EQ slicer enable */
+	if (!hufs_uic_read(host, ATTR_MTX0(AFE_CONFIG_VIII), &val)) {
+		val |= BIT(0);
+		hufs_uic_write(host, ATTR_MTX0(AFE_CONFIG_VIII), val);
+		hufs_uic_write(host, ATTR_MTX1(AFE_CONFIG_VIII), val);
+	}
+
+	/* PA_TxTrailingClocks */
+	hufs_uic_write(host, TX_TRAILING_CLOCKS_REG, TX_TRAILING_CLK_NUMS);
+
+	/* save-config time */
+	hufs_uic_write(host, VS_DDBUG_SAVE_CONFIG_TIME, SAVECFG_250NS);
+
+	/* commit, wait for the MPHY MCU, then calibrate and commit again */
+	hufs_uic_write(host, DME_MPHYCFGUPDT, DME_MPHYCFGUPDT_EN);
+	if (hufs_wait_mphy_init(host))
+		dev_warn(hba->dev, "charlotte hufs: MPHY init did not complete\n");
+	else
+		dev_dbg(hba->dev, "charlotte hufs: MPHY init done\n");
+
+	hufs_tx_rx_r_calc(host);
+	hufs_uic_write(host, DME_MPHYCFGUPDT, DME_MPHYCFGUPDT_EN);
+
+	dev_dbg(hba->dev, "charlotte hufs: MPHY pre-link config done\n");
+}
+
+/*
+ * Vendor ufs_soc_init(): bring the UFS subsystem clock/reset tree up.
+ * Without this the controller never sets UCRDY, so both the standard UIC
+ * command interface and the HUF S private UniPro path stay dead.
+ */
+static void charlotte_hufs_soc_init(struct ufs_hba *hba)
+{
+	struct charlotte_hufs_host *host = hba->priv;
+	unsigned int retry;
+	u32 val, r;
+
+	dev_dbg(hba->dev, "charlotte hufs: soc init\n");
+
+	/* 1. SD/DS = 0 */
+	writel(0x00030000, host->actrl + ACTRL_AO_MEM_CTRL2);
+
+	/* 2. release UFS subsystem CRG reset */
+	val = readl(host->sctrl + SCTRL_SCPERRSTDIS1);
+	writel(val | BIT(BIT_IP_RST_UFS_SUBSYS_CRG),
+	       host->sctrl + SCTRL_SCPERRSTDIS1);
+	for (retry = 2000; retry; retry--) {
+		if (!(readl(host->sctrl + SCTRL_SCPERRSTSTAT1) &
+		      BIT(BIT_IP_RST_UFS_SUBSYS_CRG)))
+			break;
+		udelay(1);
+	}
+	if (!retry)
+		dev_warn(hba->dev, "charlotte hufs: subsys CRG reset timeout\n");
+
+	/* 3. reset the UFS subsystem */
+	val = readl(host->sctrl + SCTRL_SCPERRSTEN1);
+	writel(val | BIT(BIT_IP_RST_UFS_SUBSYS),
+	       host->sctrl + SCTRL_SCPERRSTEN1);
+
+	/* 4. UFS subsystem clock = 224 MHz */
+	writel(0x003F0006, host->sctrl + SCTRL_SCCLKDIV9);
+
+	/* 5. release MPHY isolation */
+	writel(0x00210000, host->actrl + ACTRL_ISO_EN_GROUP0_PERI);
+
+	/* 6. enable clk_ufs_subsys */
+	val = readl(host->sctrl + SCTRL_SCPEREN4);
+	writel(val | BIT(BIT_GT_CLK_UFS_SUBSYS), host->sctrl + SCTRL_SCPEREN4);
+
+	/* 7. device hardware reset (bit10 rst_device_rst_n, bit26 mask) */
+	writel(0x04000000, host->actrl + ACTRL_BITMSK_NONSEC_CTRL1);
+	mdelay(2);
+	writel(0x04000400, host->actrl + ACTRL_BITMSK_NONSEC_CTRL1);
+	mdelay(10);
+
+	/* 8. release the master reset */
+	val = readl(host->sctrl + SCTRL_SCPERRSTDIS1);
+	writel(val | BIT(BIT_IP_RST_UFS_SUBSYS),
+	       host->sctrl + SCTRL_SCPERRSTDIS1);
+
+	/* 9. release internal resets */
+	writel(0xFFFFFFFF, host->sys_ctrl + UFS_SYSCTRL_RESET_CTRL);
+
+	/* 10. memory TRA configuration */
+	val = readl(host->sctrl + SCTRL_SCEFUSEDATA2);
+	if (!(val & BIT(20))) {
+		r = readl(host->ib_mst + UFS_IB_MST_RAM_TMOD);
+		r |= BIT(11);
+		r &= ~BIT(12);
+		writel(r, host->ib_mst + UFS_IB_MST_RAM_TMOD);
+
+		r = readl(host->sys_ctrl + UFS_SYSCTRL_MEMCTRL_TP);
+		r |= BIT(11);
+		r &= ~BIT(12);
+		writel(r, host->sys_ctrl + UFS_SYSCTRL_MEMCTRL_TP);
+	}
+	if (!(val & BIT(15))) {
+		r = readl(host->sys_ctrl + UFS_SYSCTRL_MEMCTRL);
+		r |= BIT(16);
+		r &= ~BIT(17);
+		writel(r, host->sys_ctrl + UFS_SYSCTRL_MEMCTRL);
+
+		r = readl(host->sys_ctrl + UFS_SYSCTRL_AO_MEMCTRL);
+		r |= BIT(16);
+		r &= ~BIT(17);
+		writel(r, host->sys_ctrl + UFS_SYSCTRL_AO_MEMCTRL);
+
+		r = readl(host->mphy_mcu + UFS_MPHY_MCU_MEMCTRL);
+		r |= BIT(16);
+		r &= ~BIT(17);
+		writel(r, host->mphy_mcu + UFS_MPHY_MCU_MEMCTRL);
+	}
+
+	mdelay(1);
+}
+
+static irqreturn_t charlotte_hufs_core_intr(int irq, void *data)
+{
+	struct ufs_hba *hba = data;
+	struct charlotte_hufs_host *host = hba->priv;
+	unsigned int core;
+
+	if (!host->nr_core_irq)
+		return IRQ_NONE;
+	core = irq - host->core_irq[0];
+	if (host->intr_seen < 4) {
+		dev_dbg(hba->dev, "charlotte hufs: core%u irq\n", core);
+		host->intr_seen++;
+	}
+	if (ufshcd_charlotte_core_compl(hba, core))
+		return IRQ_HANDLED;
+	return IRQ_NONE;
+}
+
+static int charlotte_hufs_init(struct ufs_hba *hba)
+{
+	struct platform_device *pdev = to_platform_device(hba->dev);
+	struct device *dev = hba->dev;
+	struct charlotte_hufs_host *host;
+	int i, ret;
+
+	host = devm_kzalloc(dev, sizeof(*host), GFP_KERNEL);
+	if (!host)
+		return -ENOMEM;
+
+	hba->priv = host;
+
+	/*
+	 * Resource 2 is the HUF S UniPro/MPHY attribute window; bank 0 is
+	 * already mapped by ufshcd_pltfrm_init() (use hba->mmio_base there).
+	 */
+	host->unipro = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(host->unipro))
+		return dev_err_probe(dev, PTR_ERR(host->unipro),
+				     "failed to map HUF S UniPro window\n");
+
+	dev_dbg(dev, "UFSHCI CAP=%#x VER=%#x HCS=%#x\n",
+		 readl(hba->mmio_base + UFSHCI_CAP),
+		 readl(hba->mmio_base + UFSHCI_VER),
+		 readl(hba->mmio_base + UFSHCI_HCS));
+
+	host->sys_ctrl = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(host->sys_ctrl))
+		return dev_err_probe(dev, PTR_ERR(host->sys_ctrl),
+				     "failed to map UFS sys ctrl\n");
+
+	host->mphy_mcu = devm_platform_ioremap_resource(pdev, 3);
+	if (IS_ERR(host->mphy_mcu))
+		return dev_err_probe(dev, PTR_ERR(host->mphy_mcu),
+				     "failed to map UFS MPHY MCU\n");
+
+	host->ib_mst = devm_platform_ioremap_resource(pdev, 4);
+	if (IS_ERR(host->ib_mst))
+		return dev_err_probe(dev, PTR_ERR(host->ib_mst),
+				     "failed to map UFS IB master\n");
+
+	host->sctrl = devm_ioremap(dev, CHARLOTTE_SCTRL_BASE, 0x1000);
+	if (!host->sctrl)
+		return -ENOMEM;
+
+	host->actrl = devm_ioremap(dev, CHARLOTTE_ACTRL_BASE, 0x1000);
+	if (!host->actrl)
+		return -ENOMEM;
+
+	host->ref_clk = devm_clk_get_optional(dev, "clk_ufsio_ref");
+	if (IS_ERR(host->ref_clk))
+		return dev_err_probe(dev, PTR_ERR(host->ref_clk),
+				     "failed to get clk_ufsio_ref\n");
+
+	host->rst = devm_reset_control_get_optional_exclusive(dev, NULL);
+	if (IS_ERR(host->rst))
+		return dev_err_probe(dev, PTR_ERR(host->rst),
+				     "failed to get UFS reset\n");
+
+	/*
+	 * Do not use UFSHCI_QUIRK_BROKEN_HCE: the generic DME_RESET/DME_ENABLE
+	 * primitives go through the standard UIC command register, which never
+	 * completes on this controller.  Let the generic core enable HCE
+	 * normally and take over the link startup ourselves (see
+	 * charlotte_hufs_dme_link_startup).
+	 */
+	dev_dbg(dev, "charlotte hufs: normal HCE path + private link startup\n");
+
+	/*
+	 * HUF S uses per-core UTP queues: doorbell/IS/IE are repeated every
+	 * 0x80 bytes starting at 0x2000, and each core has its own IRQ.
+	 */
+	hba->core_utr = true;
+	for (i = 0; i < 8; i++) {
+		int irq = platform_get_irq_optional(pdev, i + 1);
+
+		if (irq < 0)
+			break;
+		ret = devm_request_irq(dev, irq, charlotte_hufs_core_intr,
+				       IRQF_SHARED, "ufs-core", hba);
+		if (ret)
+			return ret;
+		host->core_irq[i] = irq;
+		host->nr_core_irq++;
+	}
+	dev_dbg(dev, "charlotte hufs: %u per-core irqs\n", host->nr_core_irq);
+
+	charlotte_hufs_soc_init(hba);
+
+	dev_dbg(dev, "charlotte hufs: after soc init CAP=%#x VER=%#x HCS=%#x HCE=%#x\n",
+		 readl(hba->mmio_base + UFSHCI_CAP),
+		 readl(hba->mmio_base + UFSHCI_VER),
+		 readl(hba->mmio_base + UFSHCI_HCS),
+		 readl(hba->mmio_base + UFSHCI_HCE));
+
+	return 0;
+}
+
+/* Issue a UIC command through the standard register and poll IS for completion */
+static int charlotte_hufs_hce_enable_notify(struct ufs_hba *hba,
+					    enum ufs_notify_change_status status)
+{
+	if (status != POST_CHANGE)
+		return 0;
+
+	dev_dbg(hba->dev, "charlotte hufs: HCE=%#x HCS=%#x after enable\n",
+		 readl(hba->mmio_base + UFSHCI_HCE),
+		 readl(hba->mmio_base + UFSHCI_HCS));
+	return 0;
+}
+
+static int charlotte_hufs_dme_link_startup(struct ufs_hba *hba)
+{
+	struct charlotte_hufs_host *host = hba->priv;
+	unsigned int retries = 500;
+	u32 val = 0;
+	int ret;
+
+	ret = hufs_uic_read(host, DME_UNIPRO_STATE, &val);
+	if (ret)
+		return ret;
+	dev_dbg(hba->dev, "charlotte hufs: unipro state %#x before link startup\n",
+		 val & MASK_DEBUG_UNIPRO_STATE);
+
+	ret = hufs_uic_write(host, DME_LINKSTARTUPREQ, 0x1);
+	if (ret)
+		return ret;
+
+	do {
+		if (hufs_uic_read(host, DME_UNIPRO_STATE, &val))
+			return -ETIMEDOUT;
+		if ((val & MASK_DEBUG_UNIPRO_STATE) == LINK_UP) {
+			dev_dbg(hba->dev, "charlotte hufs: link up (state %#x)\n",
+				 val & MASK_DEBUG_UNIPRO_STATE);
+			return 0;
+		}
+		usleep_range(1000, 2000);
+	} while (--retries);
+
+	dev_err(hba->dev, "charlotte hufs: link startup timeout, state %#x\n",
+		val & MASK_DEBUG_UNIPRO_STATE);
+	return -ETIMEDOUT;
+}
+
+static int charlotte_hufs_uic_change_pwr_mode(struct ufs_hba *hba, u8 mode)
+{
+	struct charlotte_hufs_host *host = hba->priv;
+	unsigned int retries = 100;
+	u32 val = 0;
+	int ret;
+
+	ret = hufs_uic_write(host, PA_PWRMODE, mode);
+	if (ret) {
+		dev_err(hba->dev, "charlotte hufs: PA_PWRMODE write failed %d\n", ret);
+		return ret;
+	}
+
+	do {
+		if (hufs_uic_read(host, DME_POWERMODEIND, &val))
+			return -ETIMEDOUT;
+		if (val && val != 0xffffffff)
+			break;
+		usleep_range(1000, 2000);
+	} while (--retries);
+
+	dev_dbg(hba->dev, "charlotte hufs: pwr mode %#x -> ind %#x\n", mode, val);
+	return 0;
+}
+
+/*
+ * In HUF S mode the standard UFSHCI error reporting is not meaningful:
+ * the controller asserts bogus UIC_ERROR + CONTROLLER_FATAL_ERROR bits
+ * during/after link startup, which makes the generic core declare a fatal
+ * error and (worse) enter its error handler before the device exists.
+ * Completions are delivered through the per-core queues instead, so keep
+ * the main interrupt line quiet during bring-up.
+ */
+static void charlotte_hufs_quiesce_irq(struct ufs_hba *hba)
+{
+	writel(0, hba->mmio_base + 0x24);		/* IE  */
+	writel(0xffffffff, hba->mmio_base + 0x20);	/* IS  */
+	readl(hba->mmio_base + 0x38);			/* UECPA */
+	readl(hba->mmio_base + 0x3c);			/* UECDL */
+	readl(hba->mmio_base + 0x40);			/* UECN  */
+	readl(hba->mmio_base + 0x44);			/* UECT  */
+	readl(hba->mmio_base + 0x48);			/* UECDME */
+	hba->saved_err = 0;
+	hba->saved_uic_err = 0;
+	hba->errors = 0;
+}
+
+/*
+ * HUF S multi-queue arbitration defaults, taken from the working 5.10
+ * driver/controller state (the subsystem reset in soc_init clears them).
+ */
+static void charlotte_hufs_qos_init(struct ufs_hba *hba)
+{
+	int i;
+
+	writel(0x001C8012, hba->mmio_base + 0xc0);	/* PROC_MODE_CFG */
+	writel(0x00003F1F, hba->mmio_base + 0xd4);	/* OUTSTANDING_NUM */
+	writel(0x07070707, hba->mmio_base + 0xd8);
+	writel(0x1F1F1F07, hba->mmio_base + 0xdc);
+	writel(0x07070707, hba->mmio_base + 0xe0);
+	writel(0x001F1F07, hba->mmio_base + 0xe4);
+	writel(0x1D1D1D1D, hba->mmio_base + 0xe8);
+	writel(0x000F0F1D, hba->mmio_base + 0xec);
+	writel(0x00000044, hba->mmio_base + 0x3b0);
+
+	for (i = 0; i < 8; i++)
+		writel(0, hba->mmio_base + 0x2010 + i * 0x80);
+
+	dev_dbg(hba->dev,
+		 "charlotte hufs: qos init D4=%#x D8=%#x DC=%#x 3B0=%#x\n",
+		 readl(hba->mmio_base + 0xd4),
+		 readl(hba->mmio_base + 0xd8),
+		 readl(hba->mmio_base + 0xdc),
+		 readl(hba->mmio_base + 0x3b0));
+}
+
+static void charlotte_hufs_dump_utrd(struct ufs_hba *hba)
+{
+	u32 tag = hba->reserved_slot;
+	u32 *p = (u32 *)hba->lrb[tag].utr_descriptor_ptr;
+
+	dev_dbg(hba->dev,
+		 "charlotte hufs: lrb[%u] utrd=%08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		 tag, p[0], p[1], p[2], p[3], p[4], p[5],
+		 p[6], p[7], p[8], p[9], p[10], p[11]);
+}
+
+static void charlotte_dump_range(struct ufs_hba *hba, const char *tag,
+				 void __iomem *base, u32 len)
+{
+	u32 off;
+
+	for (off = 0; off < len; off += 16) {
+		dev_dbg(hba->dev, "D %s %04x: %08x %08x %08x %08x\n", tag, off,
+			 readl(base + off), readl(base + off + 4),
+			 readl(base + off + 8), readl(base + off + 12));
+	}
+}
+
+/*
+ * Mirror the per-core slot configuration observed on the working 5.10
+ * system.  In particular 0x2020 reads 0xff there (all 8 slots usable);
+ * after the subsystem reset it is 0, which leaves the per-core doorbell
+ * set but the request is never fetched.
+ */
+static void charlotte_hufs_hw_config(struct ufs_hba *hba)
+{
+	int i;
+
+	for (i = 0; i < 8; i++) {
+		void __iomem *c = hba->mmio_base + 0x2000 + i * 0x80;
+
+		writel(0, c + 0x10);	/* DOORBELL_QOS */
+		writel(3, c + 0x0c);
+		writel(0xff, c + 0x20);	/* slot enable / credit mask */
+	}
+
+	dev_dbg(hba->dev, "charlotte hufs: core0 cfg IS=%#x IE=%#x @c=%#x @20=%#x\n",
+		 readl(hba->mmio_base + 0x2000), readl(hba->mmio_base + 0x2004),
+		 readl(hba->mmio_base + 0x200c), readl(hba->mmio_base + 0x2020));
+}
+
+static void charlotte_hufs_dump_all(struct ufs_hba *hba)
+{
+	struct charlotte_hufs_host *host = hba->priv;
+
+	charlotte_dump_range(hba, "hci", hba->mmio_base, 0x500);
+	charlotte_dump_range(hba, "core", hba->mmio_base + 0x2000, 0x400);
+	charlotte_dump_range(hba, "sysc", host->sys_ctrl, 0x100);
+	charlotte_dump_range(hba, "mphy", host->mphy_mcu, 0x100);
+	charlotte_dump_range(hba, "ibmst", host->ib_mst, 0x100);
+	charlotte_dump_range(hba, "sctrl", host->sctrl, 0x500);
+	charlotte_dump_range(hba, "actrl", host->actrl, 0x900);
+	charlotte_dump_range(hba, "unip", host->unipro, 0x200);
+}
+
+static void charlotte_hufs_dump_core(struct ufs_hba *hba)
+{
+	int i;
+
+	dev_dbg(hba->dev, "charlotte hufs: HCS=%#x ISg=%#x UTRLBA=%#x errs=%#x out=%#lx\n",
+		 readl(hba->mmio_base + 0x30),
+		 readl(hba->mmio_base + 0x20),
+		 readl(hba->mmio_base + 0x50),
+		 hba->errors, hba->outstanding_reqs);
+	for (i = 0; i < 8; i++) {
+		void __iomem *c = hba->mmio_base + 0x2000 + i * 0x80;
+
+		dev_dbg(hba->dev,
+			 "charlotte hufs: core%d IS=%#x IE=%#x DBR=%#x RSR=%#x\n",
+			 i, readl(c), readl(c + 4), readl(c + 0x14), readl(c + 0x1c));
+	}
+}
+
+static void charlotte_hufs_exit(struct ufs_hba *hba)
+{
+	charlotte_hufs_dump_core(hba);
+	if (hba->utrdl_base_addr)
+		charlotte_hufs_dump_utrd(hba);
+}
+
+static int charlotte_hufs_link_startup_notify(struct ufs_hba *hba,
+					      enum ufs_notify_change_status status)
+{
+	struct charlotte_hufs_host *host = hba->priv;
+
+	if (status == PRE_CHANGE) {
+		charlotte_hufs_quiesce_irq(hba);
+		charlotte_hufs_phy_pre_link(hba, host);
+	} else {
+		charlotte_hufs_quiesce_irq(hba);
+		charlotte_hufs_phy_post_link(hba, host);
+		charlotte_hufs_qos_init(hba);
+		charlotte_hufs_hw_config(hba);
+		ufshcd_charlotte_core_intr_enable(hba);
+		/*
+		 * Do not start the per-core queues here: UTRLBA is programmed
+		 * later by the generic core (ufshcd_make_hba_operational) and
+		 * enabling RSR against a zero base latches a bad state.
+		 * ufshcd_enable_run_stop_reg() enables them at the right time.
+		 */
+		dev_dbg(hba->dev,
+			 "charlotte hufs: dma utrdl=%pad ucdl=%pad\n",
+			 &hba->utrdl_dma_addr, &hba->ucdl_dma_addr);
+		charlotte_hufs_dump_core(hba);
+		charlotte_hufs_dump_utrd(hba);
+	}
+
+	return 0;
+}
+
+/*
+ * The controller only handles 32-bit DMA addresses (the working 5.10 kernel
+ * places the UTRL/UCD buffers below 4 GiB).  Restrict coherent allocations
+ * accordingly, otherwise the UTRD/UCD addresses end up above 4 GiB and the
+ * controller cannot fetch them.
+ */
+static int charlotte_hufs_set_dma_mask(struct ufs_hba *hba)
+{
+	int ret;
+
+	ret = dma_set_mask_and_coherent(hba->dev, DMA_BIT_MASK(32));
+	if (ret)
+		dev_err(hba->dev, "charlotte hufs: 32-bit DMA mask failed %d\n",
+			ret);
+	return ret;
+}
+
+static const struct ufs_hba_variant_ops charlotte_hufs_vops = {
+	.name			= "charlotte-hufs",
+	.init			= charlotte_hufs_init,
+	.exit			= charlotte_hufs_exit,
+	.set_dma_mask		= charlotte_hufs_set_dma_mask,
+	.hce_enable_notify	= charlotte_hufs_hce_enable_notify,
+	.link_startup_notify	= charlotte_hufs_link_startup_notify,
+	.dme_link_startup	= charlotte_hufs_dme_link_startup,
+	.uic_change_pwr_mode	= charlotte_hufs_uic_change_pwr_mode,
+};
+
+static const struct of_device_id charlotte_hufs_of_match[] = {
+	{ .compatible = "hisilicon,hufs", .data = &charlotte_hufs_vops },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, charlotte_hufs_of_match);
+
+static int charlotte_hufs_probe(struct platform_device *pdev)
+{
+	const struct of_device_id *match;
+
+	match = of_match_node(charlotte_hufs_of_match, pdev->dev.of_node);
+	if (!match)
+		return -ENODEV;
+
+	return ufshcd_pltfrm_init(pdev, match->data);
+}
+
+static void charlotte_hufs_remove(struct platform_device *pdev)
+{
+	ufshcd_pltfrm_remove(pdev);
+}
+
+static const struct dev_pm_ops charlotte_hufs_pm_ops = {
+	SET_SYSTEM_SLEEP_PM_OPS(ufshcd_system_suspend, ufshcd_system_resume)
+	SET_RUNTIME_PM_OPS(ufshcd_runtime_suspend, ufshcd_runtime_resume, NULL)
+};
+
+static struct platform_driver charlotte_hufs_driver = {
+	.probe = charlotte_hufs_probe,
+	.remove = charlotte_hufs_remove,
+	.driver = {
+		.name = "ufshcd-charlotte",
+		.pm = &charlotte_hufs_pm_ops,
+		.of_match_table = charlotte_hufs_of_match,
+	},
+};
+module_platform_driver(charlotte_hufs_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("HiSilicon charlotte HUF S UFS bring-up");
+MODULE_ALIAS("platform:ufshcd-charlotte");
